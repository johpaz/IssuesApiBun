{
    "name": "taskmaster-ia-backend-bun",
    "version": "1.0.0",
    "description": "Backend for TaskMaster IA with Bun, Elysia, Turso (SQLite) and Gemini AI.",
    "type": "module",
    "scripts": {
        "dev": "bun run --watch src/index.ts",
        "start": "bun run src/index.ts",
        "test": "bun test",
        "test:watch": "bun test --watch",
        "test:coverage": "bun test --coverage",
        "lint": "eslint . --ext .ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio"
    },
    "keywords": [],
    "author": "John Paez",
    "license": "ISC",
    "dependencies": {
        "@elysiajs/cors": "^1.4.1",
        "@elysiajs/jwt": "^1.1.0",
        "@google/generative-ai": "0.24.0",
        "@libsql/client": "^0.15.8",
        "bcryptjs": "3.0.2",
        "drizzle-orm": "0.44.2",
        "elysia": "^1.1.0",
        "firebase": "^11.9.0",
        "firebase-admin": "^13.4.0",
        "jose": "^6.1.3",
        "pino": "^10.3.0",
        "pino-pretty": "^13.1.3",
        "resend": "^4.5.1",
        "zod": "3.25.42"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "bun-types": "latest",
        "drizzle-kit": "^0.31.4",
        "eslint": "^9.27.0"
    },
    "peerDependencies": {
        "typescript": "^5.0.0"
    }
}
